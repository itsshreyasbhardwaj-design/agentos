# The AgentOS control-plane API this dashboard talks to.
AGENTOS_URL=http://127.0.0.1:8787

# An API key issued by that API. It is read only by the server process:
# the browser never receives it, and every mutation goes through a server action.
# Get one by starting the API with AGENTOS_SEED_DEMO=true, or POST /v1/api-keys.
AGENTOS_API_KEY=
