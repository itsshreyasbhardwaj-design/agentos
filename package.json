{
  "name": "agentos",
  "version": "0.1.0",
  "private": true,
  "description": "AgentOS — a production-grade runtime and control plane for AI agents",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:all": "pnpm build && pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm -r exec tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "tsx benchmarks/run.ts",
    "dev:api": "pnpm --filter @agentos/api dev",
    "dev:worker": "pnpm --filter @agentos/worker dev",
    "dev:web": "pnpm --filter @agentos/web dev",
    "e2e": "playwright test",
    "seed": "pnpm --filter @agentos/api seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.39.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.2",
    "@electric-sql/pglite": "^0.5.8",
    "@types/pg": "^8.15.6",
    "@agentos/core": "workspace:*",
    "@agentos/events": "workspace:*",
    "@agentos/policy": "workspace:*",
    "@agentos/providers": "workspace:*",
    "@agentos/tools": "workspace:*",
    "@agentos/memory": "workspace:*",
    "@agentos/store": "workspace:*",
    "@agentos/queue": "workspace:*",
    "@agentos/runtime": "workspace:*",
    "@agentos/sdk": "workspace:*",
    "@agentos/mcp-server": "workspace:*"
  }
}
